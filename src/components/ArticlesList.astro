---
type TagItem = {
	title: string;
	slug: string;
};

type ArticleItem = {
	id: string;
	title: string;
	publishedAt: string | Date;
	tags: TagItem[];
};

type Props = {
	posts: ArticleItem[];
	heading?: string;
	emptyMessage?: string;
	class?: string;
};

const { posts, heading = 'Articles', emptyMessage, class: className } = Astro.props;
---

<section id="articles" class:list={['articles', className]}>
	<h2
		class="p-6 sm:p-10 lg:p-12 pb-3 sm:pb-5 lg:pb-6 font-display text-2xl font-bold border-b border-border-muted"
	>
		{heading}
	</h2>
	<ul class="pb-6 sm:pb-10 lg:pb-12">
		{
			posts.length > 0 ? (
				posts.map((post, index) => (
					<li
						class="article-item border-b border-border-muted"
						style={`transition-delay: ${index * 0.1}s`}
					>
						<a
							href={`/blog/${post.id}/`}
							class="article-link grid grid-cols-2 gap-x-[2%] gap-y-2 items-start px-6 sm:px-10 lg:px-12 py-4 md:grid-cols-[60%_18%_18%] md:items-center md:gap-y-0"
						>
							<p class="col-span-2 m-0 font-display text-base font-bold leading-snug md:col-span-1">
								{post.title}
							</p>
							<p class="m-0 text-sm tabular-nums">
								{new Date(post.publishedAt).getFullYear()}
							</p>
							{post.tags.length > 0 ? (
								<ul class="m-0 flex flex-wrap justify-end gap-2 p-0 list-none text-sm">
									{post.tags.map((tag) => (
										<li class="tag">{tag.title}</li>
									))}
								</ul>
							) : (
								<span />
							)}
						</a>
					</li>
				))
			) : emptyMessage ? (
				<li class="article-item px-6 sm:px-10 lg:px-12 py-8 text-sm">{emptyMessage}</li>
			) : null
		}
	</ul>
</section>

<style>
	.articles {
		flex: 1;
	}
</style>
