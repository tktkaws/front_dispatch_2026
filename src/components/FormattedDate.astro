---
interface Props {
	date: Date;
}

const { date } = Astro.props;

const months = [
	'Jan.',
	'Feb.',
	'Mar.',
	'Apr.',
	'May',
	'Jun.',
	'Jul.',
	'Aug.',
	'Sep.',
	'Oct.',
	'Nov.',
	'Dec.',
] as const;

const formatted = `${months[date.getMonth()]} ${date.getFullYear()}`;
---

<time datetime={date.toISOString()}>{formatted}</time>
