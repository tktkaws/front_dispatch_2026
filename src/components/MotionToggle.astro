<button
	type="button"
	class="content-button motion-toggle"
	data-motion-toggle
	aria-label="アニメーションをオフにする"
>
	<span class="motion-toggle__label motion-toggle__label--reduce" aria-hidden="true">Reduce</span>
	<span class="motion-toggle__label motion-toggle__label--motion" aria-hidden="true">Motion</span>
</button>

<style>
	.motion-toggle__label {
		display: none;
	}

	:global(html[data-motion='motion']) .motion-toggle__label--reduce,
	:global(html[data-motion='reduce']) .motion-toggle__label--motion {
		display: inline;
	}
</style>

<script>
	const button = document.querySelector('[data-motion-toggle]');

	const syncLabel = (preference) => {
		if (!(button instanceof HTMLButtonElement)) return;
		button.setAttribute(
			'aria-label',
			preference === 'reduce' ? 'アニメーションをオンにする' : 'アニメーションをオフにする',
		);
	};

	if (button instanceof HTMLButtonElement && window.__motionPreference) {
		const { resolve, toggle } = window.__motionPreference;
		syncLabel(resolve());

		button.addEventListener('click', () => {
			toggle();
			syncLabel(resolve());
		});

		document.addEventListener('motion-preference-change', (event) => {
			if (event instanceof CustomEvent) syncLabel(event.detail);
		});
	}
</script>
