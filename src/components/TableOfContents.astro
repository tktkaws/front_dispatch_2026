---
import type { Heading } from '../lib/microcms';

interface Props {
	headings: Heading[];
	headingId?: string;
}

const { headings, headingId = 'toc-heading' } = Astro.props;
---

{
	headings.length > 0 && (
		<nav class="toc" aria-labelledby={headingId}>
			<p id={headingId} class="toc-title text-xl font-bold mb-4">Contents</p>
			<ol>
				{headings.map((heading) => (
					<li class={`depth-${heading.depth}`}>
						<a href={`#${heading.slug}`}>- {heading.text}</a>
					</li>
				))}
			</ol>
		</nav>
	)
}

<style>
	.toc ol {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.toc a {
		color: inherit;
		text-decoration: none;
	}

	.depth-3 {
		padding-left: 1.25rem;
	}
</style>
