---

<button
	type="button"
	class="content-button theme-toggle"
	data-theme-toggle
	aria-label="カラーテーマを切り替え"
>
	<span class="theme-toggle__label theme-toggle__label--dark" aria-hidden="true">Dark</span>
	<span class="theme-toggle__label theme-toggle__label--light" aria-hidden="true">Light</span>
</button>

<style>
	.theme-toggle__label {
		display: none;
	}

	:global(html[data-theme='light']) .theme-toggle__label--dark,
	:global(html[data-theme='dark']) .theme-toggle__label--light {
		display: inline;
	}
</style>

<script>
	const button = document.querySelector('[data-theme-toggle]');

	const syncLabel = (scheme) => {
		if (!(button instanceof HTMLButtonElement)) return;
		button.setAttribute(
			'aria-label',
			scheme === 'dark' ? 'ライトモードに切り替え' : 'ダークモードに切り替え',
		);
	};

	if (button instanceof HTMLButtonElement && window.__colorScheme) {
		const { resolve, toggle } = window.__colorScheme;
		syncLabel(resolve());

		button.addEventListener('click', () => {
			toggle();
			syncLabel(resolve());
		});

		document.addEventListener('color-scheme-change', (event) => {
			if (event instanceof CustomEvent) syncLabel(event.detail);
		});
	}
</script>
