---
import { SITE_TITLE } from '../consts';
import MotionToggle from './MotionToggle.astro';
import ThemeToggle from './ThemeToggle.astro';

const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';
---

{
	isHome ? (
		<header class="p-6 sm:p-10 lg:p-12">
			<h1 class="font-display text-lg sm:text-3xl lg:text-4xl font-bold">{SITE_TITLE}</h1>
		</header>
	) : (
		<header class="global-header p-6 sm:p-10 lg:p-12">
			<a href="/" class="w-fit">
				<span class="font-display text-lg sm:text-3xl lg:text-4xl font-bold w-fit">{SITE_TITLE}</span>
			</a>
		</header>
	)
}
<div class="site-controls">
	<MotionToggle />
	<ThemeToggle />
</div>

<style>
	header {
		width: min(100%, 1600px);
		margin: 0 auto;
		border-left: 1px solid var(--color-border);
		border-right: 1px solid var(--color-border);
		border-bottom: 1px solid var(--color-border);
	}
	@media screen and (max-width: 1600px) {
		header {
			border-left: 0;
			border-right: 0;
		}
	}

	.site-controls {
		--site-controls-inset: 1.5rem; /* header p-6 と揃える */
		box-sizing: border-box;
		position: fixed;
		top: var(--site-controls-inset);
		right: calc(max(0px, (100vw - 1600px) / 2) + var(--site-controls-inset));
		z-index: 50;
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-end;
		gap: 0.5rem;
	}

	@media (min-width: 640px) {
		.site-controls {
			--site-controls-inset: 2.5rem; /* header sm:p-10 と揃える */
		}
	}

	@media (min-width: 1024px) {
		.site-controls {
			--site-controls-inset: 3rem; /* header lg:p-12 と揃える */
		}
	}
</style>
