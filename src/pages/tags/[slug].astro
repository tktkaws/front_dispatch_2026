---
import { type CollectionEntry, getCollection } from 'astro:content';
import ArticlesList from '../../components/ArticlesList.astro';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import TagsList from '../../components/TagsList.astro';
import { SITE_TITLE } from '../../consts';

export async function getStaticPaths() {
	const posts = await getCollection('blogs');
	const usedTagSlugs = new Set(posts.flatMap((post) => post.data.tags.map((t) => t.slug)));
	const allTags = (await getCollection('tags'))
		.filter((tag) => usedTagSlugs.has(tag.data.slug))
		.sort((a, b) => a.data.title.localeCompare(b.data.title, 'ja'));

	return allTags.map((tag) => ({
		params: { slug: tag.data.slug },
		props: {
			tag,
			tags: allTags,
			posts: posts
				.filter((post) => post.data.tags.some((t) => t.slug === tag.data.slug))
				.sort(
					(a, b) =>
						new Date(b.data.publishedAt).valueOf() -
						new Date(a.data.publishedAt).valueOf(),
				),
		},
	}));
}

type Props = {
	tag: CollectionEntry<'tags'>;
	tags: CollectionEntry<'tags'>[];
	posts: CollectionEntry<'blogs'>[];
};

const { tag, tags, posts } = Astro.props;
const title = `${tag.data.title} | ${SITE_TITLE}`;
const description = `${tag.data.title} に関する記事一覧`;
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header />
		<main>
			<TagsList
				tags={tags.map((t) => ({ title: t.data.title, slug: t.data.slug }))}
				currentSlug={tag.data.slug}
			/>
			<ArticlesList
				posts={posts.map((post) => ({
					id: post.id,
					title: post.data.title,
					publishedAt: post.data.publishedAt,
					tags: post.data.tags,
				}))}
				emptyMessage="このタグの記事はまだありません。"
			/>
		</main>
		<Footer />
	</body>
</html>
